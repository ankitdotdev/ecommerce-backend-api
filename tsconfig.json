{
  "compilerOptions": {
    "target": "ES2020",

    "module": "CommonJS",

    "rootDir": "./src",

    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,

    "ignoreDeprecations": "6.0",
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },

  "include": ["src"],

  "exclude": ["node_modules"]
}
